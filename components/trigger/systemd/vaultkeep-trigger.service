[Unit]
Description=VaultKeep Trigger monitor (wallet shutdown backup monitoring)
Documentation=man:systemd.service(5)
After=default.target

[Service]
Type=simple
ExecStart=/usr/local/bin/vaultkeep-trigger monitor
Restart=on-failure
RestartSec=5
UMask=0077
StandardOutput=journal
StandardError=journal

# Add an explicit configuration path when not using the default location:
# ExecStart=/usr/local/bin/vaultkeep-trigger --config /absolute/path/config.toml monitor

[Install]
WantedBy=default.target
