## Vaultkeep — scheduled backup example
## Copy to /etc/vaultkeep/jobs/example.yaml or a user-mode jobs directory.
## The filename must match job.id. Replace example paths before enabling.
## Convention: ## = explanation; # key: value = disabled option.

config_version: 1                         # Supported: 1

## Job
job:
  id: example                            # Letters, digits, _ or -; max 128

## Archive grouping
# backup_mode: combined                  # combined (default) | per_file
## per_file requires one source directory and follow_symlinks: false.

## Sources
sources:
  - path: /path/to/source                # Absolute file or directory
    archive_path_mode: prefix           # prefix | preserve
    archive_prefix: source              # Prefix; "" places files at archive root
    # exclude:                          # Source-only gitwildmatch patterns
    #   - cache/
    #   - "*.tmp"
    #   - "**/node_modules/**"

# exclude:                               # Global gitwildmatch patterns
#   - "*.swp"
#   - "**/.cache/**"

## Source handling
source_options:
  follow_symlinks: false                 # Follow symlink targets
  cross_filesystems: false              # Traverse nested mounts
  ignore_missing: false                 # Allow missing sources

## Destination
destination:
  root: /mnt/backups/example            # Local, CIFS or NFS path
  name_template: "backup-{job}-{timestamp_utc:%Y%m%dT%H%M%SZ}"
  # marker_file: ".vaultkeep-target"     # Relative path; create file yourself
  # expected_fstype: cifs               # Require matching filesystem type

## Archive
archive:
  format: tar.zst                        # tar.zst | tar.7z
  # compression_level: 6                # tar.zst: 1–19; tar.7z: 1–9

## Encryption
encryption:
  mode: none                            # tar.zst: none; tar.7z: password
  # password_file: /etc/vaultkeep/secrets/example.passphrase  # For tar.7z + password mode

## Retention (counts per tier; at least one must be positive)
retention:
  hourly: 24
  daily: 7
  weekly: 8
  monthly: 12
  yearly: 3

## Schedule (cannot be enabled alongside trigger)
schedule:
  enabled: false                        # Enable the systemd timer
  interval: daily                       # hourly | daily | weekly | monthly
  window: "01:00-05:00"                 # Local-time range; alternative to at
  # at: "03:30"                         # Fixed local time; alternative to window
  # day: sunday                         # Required for weekly; monday–sunday
  # day: 1                              # Required for monthly; 1–28
  persistent: true                      # One catch-up activation after downtime

## Shutdown trigger (alternative to schedule)
## Electrum identity below is illustrative; see app-specific examples.
trigger:
  enabled: false
  # app: electrum                        # electrum | bisq | wasabi
  # data_dir: /home/user/.electrum       # Application data directory
  # matcher:
  #   entrypoints:                      # At least one; script | jar | java_main
  #     - kind: script
  #       value: /home/user/.local/opt/electrum/current/run_electrum
  #   exe_realpath: /usr/bin/python3    # Optional process executable check
  #   argv_tokens: []                   # Optional argument tokens
  #   cmdline_regex: 'run_electrum'      # Optional command-line regex
  #   env_eq: {}                        # App-specific permitted environment keys
  # poll_seconds: 2                     # Process observation interval
  # confirm_seconds: 5                  # Continuous absence before shutdown
  # deadline_seconds: 3600              # Advisory; never terminates backup
  # params: {}                          # String runtime parameters

## Hooks (null = disabled; commands run with /bin/sh -c)
hooks:
  before_check: null
  before_archive: null
  after_archive: null
  on_success: null
  on_failure: null
  on_unchanged: null

  ## Hook example: replace a null phase above to enable it.
  ## Timeout: 1–3600 seconds (default 300).
  # before_check:
  #   command: '/usr/local/sbin/prepare-app-backup --job "{job}"'
  #   timeout_seconds: 300

## Desktop notifications (backup and trigger are independent)
notifications:
  command: notify-send                   # Notification command
  timeout_ms: 5000                      # Display timeout
  backup:
    enabled: false
  trigger:
    enabled: false

## Logging
logging:
  level: info                           # error | warning | info | debug
  # include_command_output: false       # Include subprocess output in logs
